# =============================================================================
# Crawl4AI - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values

# -----------------------------------------------------------------------------
# PostgreSQL Database Configuration
# -----------------------------------------------------------------------------
POSTGRES_DB=crawl4ai
POSTGRES_USER=crawl4ai
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_PORT=5432

# Database URL (constructed from above values)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://crawl4ai:changeme_in_production@postgres:5432/crawl4ai

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
# Backend API port
BACKEND_PORT=11235

# Frontend port (if enabled)
FRONTEND_PORT=8080

# Scheduler timezone (for task scheduling)
SCHEDULER_TIMEZONE=Asia/Shanghai

# Upload directory (inside container)
UPLOAD_DIR=/app/uploads

# -----------------------------------------------------------------------------
# Docker Image Configuration
# -----------------------------------------------------------------------------
# Image tag (latest, v0.8.0, etc.)
TAG=latest

# Install type (default, torch, transformer, all)
INSTALL_TYPE=default

# Enable GPU support (true/false)
ENABLE_GPU=false

# -----------------------------------------------------------------------------
# Production Security Notes
# -----------------------------------------------------------------------------
# IMPORTANT: Before deploying to production:
# 1. Change POSTGRES_PASSWORD to a strong password
# 2. Update DATABASE_URL with the new password
# 3. Consider using Docker secrets for sensitive values
# 4. Enable authentication in the backend if exposed to public
# 5. Use HTTPS/TLS for frontend and backend communication
# 6. Set up proper firewall rules
# 7. Regular database backups
# 8. Monitor resource usage (memory, disk, CPU)
